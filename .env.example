# ── App web (apps/web) ── Copia a apps/web/.env.local para desarrollo.
# La configuración web de Firebase NO es secreta (la protegen las reglas de seguridad).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Notificaciones web push (Firebase → Configuración → Cloud Messaging → Certificados web push)
VITE_FIREBASE_VAPID_KEY=
# URL del Cloudflare Worker, p. ej. https://fina-api.tu-cuenta.workers.dev
VITE_WORKER_URL=
# Número del bot de WhatsApp con lada, sin "+": 5215512345678
VITE_WHATSAPP_NUMBER=
# Dominio para recibir correos del banco (Cloudflare Email Routing). Opcional.
VITE_EMAIL_DOMAIN=

# ── Worker (apps/worker) ── ¡NUNCA en el repo! Se cargan con `wrangler secret put NOMBRE`
# o como "Repository secrets" en GitHub. Lista en docs/GUIA-DUENO.md:
# FIREBASE_SERVICE_ACCOUNT, WHATSAPP_TOKEN, WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN,
# WHATSAPP_PHONE_NUMBER_ID, PHONE_HASH_SALT
